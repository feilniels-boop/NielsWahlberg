# Kopiér til .env (lokalt) eller sæt som miljøvariabler på Railway.
# INGEN af disse værdier må committes med rigtige nøgler.
# Alle nøgler bruges KUN server-side. De må aldrig bundles til klienten.

# ── Resend (mail) ────────────────────────────────────────────────
# API-nøgle: https://resend.com/api-keys
RESEND_API_KEY=

# Afsender af funnel-mails + notifikationer. Skal være på et domæne du har
# verificeret i Resend. ALDRIG en no-reply adresse.
MAIL_FROM=Niels Wahlberg <niels@nielswahlberg.dk>

# Hvem notifikationer om nye leads sendes til.
NOTIFY_EMAIL=feilniels@gmail.com

# ── Supabase (leads + page_views) ────────────────────────────────
# SAMME projekt som tracking.js peger på. URL er offentlig; service-role
# nøglen er HEMMELIG (bypasser RLS) og må kun findes i miljøet.
SUPABASE_URL=https://brskrvvnisnuslufkeqi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (plan-generering) ─────────────────────────────────────
# https://console.anthropic.com/ — kaldes KUN fra server-routes.
ANTHROPIC_API_KEY=

# ── Admin ────────────────────────────────────────────────────────
# Kodeord til /admin/lead/[id]. Vælg et langt, tilfældigt kodeord.
ADMIN_PASSWORD=

# ── Øvrigt ───────────────────────────────────────────────────────
# Sidens offentlige URL — bruges til at bygge links i mails.
SITE_URL=https://nielswahlberg.dk

# Cal.com bookinglink (bruges på plan-side + i mails). Sæt den her, ellers
# bruges en placeholder. Bookinglinket på takkesiden (/en/thanks) er statisk
# HTML og skal rettes direkte i filen. Samme gælder Skool-linket.
BOOKING_URL=https://cal.com/nielswahlberg

# Slå auto-afsendelse af mail 1 til (1/true). Som standard fra: mail 1
# godkendes manuelt i admin før den sendes.
AUTO_SEND_MAIL1=0

# ── Eksisterende feedback-formular (dansk /feedback + /forretning) ─
FEEDBACK_TO_EMAIL=feilniels@gmail.com
FEEDBACK_FROM_EMAIL=Niels Wahlberg <onboarding@resend.dev>
